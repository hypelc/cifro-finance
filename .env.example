# PostgreSQL connection string from Supabase > Connect.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require

# Supabase project URL and publishable/anon key.
# The key is safe for the backend when it is used only to validate a user token.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Performance controls. Keep the pool disabled until its connection budget
# has been calculated for the number of Render workers/instances.
DB_POOL_ENABLED=false
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=2
DB_POOL_TIMEOUT_SECONDS=3
DB_POOL_MAX_WAITING=8
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=1000
AUTH_HTTP_TIMEOUT_SECONDS=5
PERF_LOG_ENABLED=false
PERF_LOG_SAMPLE_RATE=1
